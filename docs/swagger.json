                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SDK - Events"
                ],
                "summary": "Ingest batched behavioral events",
                "parameters": [
                    {
                        "type": "string",
                        "description": "HMAC-SHA256 signature of the request body",
                        "name": "X-Signature",
                        "in": "header"
                    },
                    {
                        "description": "Batched events",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_events_interfaces_http.IngestEventsRequest"
                        }
