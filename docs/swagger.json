        "/events": {
            "post": {
                "security": [
                    {
                        "APIKeyAuth": []
                    }
                ],
                "description": "Accepts domain-agnostic SDK events (screen views, content views, searches, etc.). Returns 202; intent prediction runs asynchronously.",
