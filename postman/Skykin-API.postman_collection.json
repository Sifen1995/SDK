        },
        {
          "name": "5. Login Developer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const data = j.data || j;",
                  "if (data.token) pm.environment.set('portalToken', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@company.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portal/login"
          },
          "response": []
        },
        {
          "name": "6. Create Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const creds = (j.data && j.data.credentials) ? j.data.credentials : {};",
                  "if (creds.publishable_key) pm.environment.set('publishableKey', creds.publishable_key);",
                  "if (creds.secret_key) pm.environment.set('secretKey', creds.secret_key);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{portalToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_name\": \"E2E Flutter\",\n  \"platform\": \"flutter\",\n  \"bundle_id\": \"com.skykin.e2e\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portal/applications"
          },
          "response": []
        },
        {
          "name": "7. Ingest Events",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.environment.get('secretKey');",
                  "const pub = pm.environment.get('publishableKey');",
                  "const body = pm.request.body.raw;",
                  "const sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Signature', value: sig });",
                  "pm.request.headers.upsert({ key: 'X-API-Key', value: pub });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"events\": [\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_type\": \"content_viewed\",\n      \"domain\": \"crypto\",\n      \"session_id\": \"{{$guid}}\",\n      \"screen_name\": \"btc\",\n      \"metadata\": { \"asset\": \"BTC\" },\n      \"device_type\": \"mobile\",\n      \"platform\": \"flutter\",\n      \"app_version\": \"1.0.0\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/events"
          },
          "response": []
        },
        {
          "name": "8. Predict Intent (connect WS first)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.environment.get('secretKey');",
                  "const pub = pm.environment.get('publishableKey');",
                  "const body = pm.request.body.raw;",
                  "const sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Signature', value: sig });",
                  "pm.request.headers.upsert({ key: 'X-API-Key', value: pub });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/intents/predict",
            "description": "Manually connect WebSocket to ws://localhost:8081/api/v1/ws/rewards/{{userId}} before this step."
          },
          "response": []
        }
      ]
    }
  ]
}
