    {
      "name": "Ad Portal — Admin",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adPortalToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Create Portal User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Analyst Jane\",\n  \"email\": \"analyst@acme.com\",\n  \"password\": \"SecurePass1!\",\n  \"role\": \"read_only_analyst\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/admin/users",
            "description": "Requires operator_admin JWT. Run **Login Operator Admin** first."
          },
          "response": []
        },
        {
          "name": "List Segment Candidates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list[0] && list[0].id) {",
                  "  pm.environment.set('candidateId', list[0].id);",
                  "  console.log('candidateId saved:', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ad-portal/admin/audience/segment-candidates?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ad-portal", "admin", "audience", "segment-candidates"],
              "query": [{ "key": "status", "value": "pending" }]
            },
            "description": "Requires operator_admin JWT. Lists candidates from the nightly intent classification scan."
          },
          "response": []
        },
        {
          "name": "Run Intent Consistency Analysis",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ad-portal/admin/analytics/intent-consistency/run",
            "description": "Triggers async classification scan. Returns 202 immediately."
          },
          "response": []
        },
        {
          "name": "Approve Segment Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.id) pm.environment.set('segmentId', j.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee Enthusiasts\",\n  \"description\": \"Users with sustained coffee purchase intent\",\n  \"estimated_cpm\": 4.5\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/admin/audience/segment-candidates/{{candidateId}}/approve",
            "description": "Publishes segment and writes segment_memberships. Set `candidateId` from List Segment Candidates."
          },
          "response": []
        },
        {
          "name": "Reject Segment Candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Insufficient user volume\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/admin/audience/segment-candidates/{{candidateId}}/reject",
            "description": "Marks a pending candidate as rejected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Developer Portal (SDK keys)",
      "description": "Obtain publishable_key + secret_key for Flutter/SDK. Token: `portalToken`.",
      "item": [
        {
          "name": "Register Developer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile Team\",\n  \"email\": \"dev@company.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portal/register"
          },
          "response": []
        },
        {
          "name": "Login Developer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const data = j.data || j;",
                  "if (data.token) pm.environment.set('portalToken', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@company.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portal/login"
          },
          "response": []
        },
        {
          "name": "Create Application (Flutter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const creds = (j.data && j.data.credentials) ? j.data.credentials : (j.credentials || {});",
                  "if (creds.publishable_key) pm.environment.set('publishableKey', creds.publishable_key);",
                  "if (creds.secret_key) pm.environment.set('secretKey', creds.secret_key);",
                  "console.log('SDK keys saved to environment');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{portalToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_name\": \"My Flutter App\",\n  \"platform\": \"flutter\",\n  \"bundle_id\": \"com.company.myapp\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portal/applications",
            "description": "secret_key shown once — saved to `secretKey` env by test script."
          },
          "response": []
        },
        {
          "name": "List Applications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{portalToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/portal/applications"
          },
          "response": []
        }
      ]
    },
    {
      "name": "SDK — Events & Intents (Flutter)",
      "description": "Requires publishableKey + secretKey. HMAC auto-signed by folder pre-request script.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const secret = pm.environment.get('secretKey');",
              "const pub = pm.environment.get('publishableKey');",
              "if (!secret || !pub) {",
              "  console.warn('Run Developer Portal > Create Application first');",
              "  return;",
              "}",
              "const body = pm.request.body ? pm.request.body.raw : '';",
              "if (!body) return;",
              "const sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'X-Signature', value: sig });",
              "pm.request.headers.upsert({ key: 'X-API-Key', value: pub });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "item": [
        {
          "name": "Ingest Events (crypto batch)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"events\": [\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_type\": \"content_viewed\",\n      \"domain\": \"crypto\",\n      \"session_id\": \"{{$guid}}\",\n      \"screen_name\": \"asset_details\",\n      \"metadata\": { \"asset\": \"BTC\", \"duration_ms\": 4200 },\n      \"device_type\": \"mobile\",\n      \"platform\": \"flutter\",\n      \"app_version\": \"1.0.0\",\n      \"created_at\": \"2026-06-02T12:00:00Z\"\n    },\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_type\": \"search_performed\",\n      \"domain\": \"crypto\",\n      \"session_id\": \"{{$guid}}\",\n      \"screen_name\": \"search\",\n      \"metadata\": { \"query\": \"bitcoin price\" },\n      \"device_type\": \"mobile\",\n      \"platform\": \"flutter\",\n      \"app_version\": \"1.0.0\",\n      \"created_at\": \"2026-06-02T12:01:00Z\"\n    },\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_type\": \"screen_viewed\",\n      \"domain\": \"crypto\",\n      \"session_id\": \"{{$guid}}\",\n      \"screen_name\": \"wallet\",\n      \"metadata\": { \"tab\": \"portfolio\" },\n      \"device_type\": \"mobile\",\n      \"platform\": \"flutter\",\n      \"app_version\": \"1.0.0\",\n      \"created_at\": \"2026-06-02T12:02:00Z\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/events",
            "description": "Returns 202. Use new UUIDs each run ({{$guid}}). Run 2–3 times before predict."
          },
          "response": []
        },
        {
          "name": "Predict Intent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/intents/predict",
            "description": "Connect WebSocket first. Triggers campaign_ad + optional reward_earned."
          },
          "response": []
        }
      ]
    },
