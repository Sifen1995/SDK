{
  "info": {
    "_postman_id": "skykin-platform-api",
    "name": "Skykin Platform API",
    "description": "Campaign Ad Portal (frontend), Developer Portal (SDK keys), and SDK (Flutter) endpoints.\n\n**Setup:** Import `Skykin-Local.postman_environment.json`, select environment **Skykin — Local**, run `docker compose up`.\n\n**Docs:** `docs/AD_PORTAL_POSTMAN.md`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ping",
            "description": "API health check."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ad Portal — Auth (Campaign UI)",
      "description": "JWT campaign management portal for React/Next.js. Token variable: `adPortalToken`.",
      "item": [
        {
          "name": "Register Advertiser",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Ads\",\n  \"email\": \"advertiser@test.com\",\n  \"password\": \"SecurePass1!\",\n  \"company_name\": \"Acme Inc\",\n  \"role\": \"advertiser\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/register",
            "description": "Self-register as `advertiser` or `read_only_analyst`."
          },
          "response": []
        },
        {
          "name": "Login Advertiser",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.token) {",
                  "  pm.environment.set('adPortalToken', j.token);",
                  "  console.log('adPortalToken saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"advertiser@test.com\",\n  \"password\": \"SecurePass1!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/login"
          },
          "response": []
        },
        {
          "name": "Login Operator Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.environment.set('adPortalToken', j.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ad-portal/login",
            "description": "Default seeded admin. Override with ADMIN_EMAIL / ADMIN_PASSWORD env on server."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adPortalToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ad-portal/me"
          },
          "response": []
        }
      ]
    },
